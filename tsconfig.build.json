{
  // The PUBLISH build: self-contained (no extends), with the same strict
  // policy as tsconfig.json. Emits ESM JavaScript and declarations to dist/
  // and NOTHING that maps back to the source: no source maps, no declaration
  // maps, no inlined sources (scripts/pack-check.mjs fails if any appear).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSourceMap": false,
    "inlineSources": false,
    "removeComments": false,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"],
  // src/global.ts is the classic-script bundle's entry (scripts/build.mjs):
  // it ships only inside dist/mailcheck.global.js.
  "exclude": ["src/**/*.test.ts", "src/global.ts"]
}
